{
    "cleanUrls": true,
    "functions": {
        "backend/api/index.js": {
            "maxDuration": 30
        }
    },
    "rewrites": [
        {
            "source": "/api",
            "destination": "/backend/api/index.js"
        },
        {
            "source": "/api/(.*)",
            "destination": "/backend/api/index.js"
        },
        {
            "source": "/",
            "destination": "/frontend/index.html"
        },
        {
            "source": "/((?!api/|backend/).*)",
            "destination": "/frontend/$1"
        }
    ]
}
